modules = ["nodejs-20", "web", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/hope2-academy-mobile: Expo"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/hope2-academy: web"

[[workflows.workflow]]
name = "artifacts/hope2-academy-mobile: Expo"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/hope2-academy-mobile run dev"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "artifacts/hope2-academy: web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=20805 BASE_PATH=/ pnpm --filter @workspace/hope2-academy run dev"
waitForPort = 20805

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3000

[[ports]]
localPort = 8083
externalPort = 3002

[[ports]]
localPort = 19936
externalPort = 3001

[[ports]]
localPort = 20805
externalPort = 80

[nix]
channel = "stable-25_05"
